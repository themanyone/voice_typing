# ── model path resolution ────────────────────────────────────────────────────
# Priority: WHISPER_MODEL env var > common locations
resolve_model() {
    local model="${WHISPER_MODEL:-}"
    [ -n "$model" ] && [ -f "$model" ] && echo "$model" && return 0

    # Try a few common locations
    local candidates=(
        "./models/ggml-tiny.en.bin"
        "$HOME/Downloads/src/whisper.cpp/models/ggml-tiny.en-q4_0.bin"
        "$HOME/Downloads/src/whisper.cpp/models/ggml-tiny.en.bin"
        "$HOME/.local/share/whisper.cpp/ggml-tiny.en-q4_0.bin"
        "/usr/local/share/whisper.cpp/ggml-tiny.en-q4_0.bin"
    )
    for c in "${candidates[@]}"; do
        if [ -f "$c" ]; then
            echo "$c"
            return 0
        fi
    done
    return 1
}

MODEL=$(resolve_model)
if [ -z "$MODEL" ]; then
    echo "whisper model not found. Set WHISPER_MODEL or download one:" >&2
    echo "  cd whisper.cpp && bash models/download-ggml-model.sh tiny.en" >&2
    exit 1
fi

# fifo queue to hold temporary audio file names
audio_fifo=$(mktemp); rm "$audio_fifo" ; mkfifo "$audio_fifo"

# flag parsing
use_flow=false
if [[ "$1" == "-flow" ]]; then
    use_flow=true
fi

## create a trap to remove temp files on untimely exit
cleanup() {
    rm -f /tmp/tmp.txt "$audio_fifo"
}
trap cleanup 0

# function to process audio files from queue
trans(){
    while read audio; do
        # transcribe audio with whisper-cli (whisper.cpp)
        whisper-cli -f "$audio" -l en -m "$MODEL" -sns \
            -otxt -of /tmp/tmp_voice_typing -np 2>/dev/null
        # remove temporary audio file
        rm -f "$audio"
	# get extracted text from tmp file & delete it
        extracted_text=$(</tmp/tmp_voice_typing.txt)
	rm -f /tmp/tmp_voice_typing.txt
        # strip whitespace & log text to the terminal
	extracted_text="${extracted_text//$'\n'/}"
	extracted_text="${extracted_text## }"
        echo "${extracted_text}"
        # Some basic editing commands -s case-insensitive
	shopt -s nocasematch
        if [[ "$extracted_text" =~ "New line." ]] || [[ "$extracted_text" =~ "Enter." ]] || [[ "$extracted_text" =~ "Submit." ]]; then
            ydotool key 28:1 28:0
        elif [[ "$extracted_text" =~ "New paragraph." ]]; then
            ydotool key 28:1 28:0 28:1 28:0
        elif [[ "$extracted_text" =~ "Period." ]] || [[ "$extracted_text" =~ "Full stop." ]]; then
            ydotool key 14:1 14:0 52:1 52:0 57:1 57:0
	elif [[ "$extracted_text" =~ "Backspace." ]]; then
	    ydotool key 14:1 14:0
        elif [[ "$extracted_text" =~ "Undo that." ]] || [[ "$extracted_text" =~ "Scratch that." ]]; then
            ydotool key 29:1 53:1 53:0 44:1 44:0 29:0
        elif [[ "$extracted_text" =~ "Shift Enter." ]] || [[ "$extracted_text" =~ "Send it." ]]; then
             ydotool key 42:1 28:1 28:0 42:0
        # Thanks for watching! seems to occur frequently in these models
        elif (( ${#extracted_text} > 3 )) && ! [[ "$extracted_text" =~ "Thanks for watching" ]] \
            && ! [[ "$extracted_text" =~ '[' ]]; then
            if [ "$use_flow" = true ]; then
                ydotool type $(llama_edit "$extracted_text")" "
            else
                ydotool type "${extracted_text} "
            fi
        fi &
	shopt -u nocasematch
    done < "$audio_fifo"
    #cleanup
    rm -f "$audio_fifo"
}

# record audio in background
while true; do
    # Make temporary files to hold audio
    tmp=$(mktemp)
    # Remove it on exit
    trap 'rm "$tmp" ; exit' INT

    # Listen to the mic.
    # The `1 0.2 6%` part of this command trims one clip of silence
    # from the beginning. 6% of max volume is considered silence here.
    # `1 1.0 8%` stops after a 1.0 second pause in speech.
    # If recording never stops, increase sound threshold from 8%
    # to 10% or more. This can happen with poor recording equipment
    # or noisy environments with heaters and fans going.

    rec -c 1 -r 22050 -t mp3 "$tmp" silence 1 0.2 6% 1 1.0 8%

    # echo temporary audio file name to transcription queue
    echo "$tmp"
done > "$audio_fifo" & #The `&` lets recording run in the background.

# run audio transciption handler
trans
